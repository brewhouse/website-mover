# OpenAI — used for style guide reading, page classification, content modeling, sitemap mapping
OPENAI_API_KEY=
# Pin after listing the models available to the key
OPENAI_MODEL=

# Encrypts stored WordPress Application Passwords (32-byte base64)
CREDENTIALS_ENCRYPTION_KEY=

DATABASE_URL=postgres://mover:mover@localhost:5432/mover

# Local clone of the seed site's Pantheon repo (read-only: never commit or push there)
SEED_CODE_PATH=

# Local copy of the seed in Docker (e2e/seed/setup.sh)
SEED_LOCAL_PORT=8088
SEED_LOCAL_ADMIN_PASSWORD=
# Application Password for the local admin user wm-local (created by e2e/seed/setup.sh)
SEED_LOCAL_APP_PASSWORD=

# Seed (target) WordPress site, for development runs — needed from M1
SEED_URL=
SEED_USER=
SEED_APP_PASSWORD=
# Only if the Planeteria framework uses ACF Pro
ACF_PRO_LICENSE=
# Optional
GA4_MEASUREMENT_ID=

# Hosts the tool may reach on private addresses (SSRF guard). Development only: the local seed.
WM_ALLOW_PRIVATE_HOSTS=localhost
